[global]
error_log = /srv/www/{{.ID}}/logs/php-fpm.log
systemd_interval = 10
; A reload waits this long for requests in flight to finish before stopping their workers.
process_control_timeout = 10s

[{{.ID}}]
listen = {{.FPMSocket}}
listen.mode = 0600
pm = ondemand
pm.max_children = {{.PMMaxChildren}}
pm.process_idle_timeout = 30s
pm.max_requests = 500
request_terminate_timeout = 300s
php_admin_value[open_basedir] = /srv/www/{{.ID}}/
php_admin_value[upload_tmp_dir] = /srv/www/{{.ID}}/tmp
php_admin_value[sys_temp_dir] = /srv/www/{{.ID}}/tmp
php_admin_value[session.save_path] = /srv/www/{{.ID}}/sessions
php_admin_value[error_log] = /srv/www/{{.ID}}/logs/php-error.log
php_admin_value[pdo_mysql.default_socket] = {{.DBSocket}}
php_admin_value[mysqli.default_socket] = {{.DBSocket}}
php_admin_value[opcache.jit] = off
php_admin_value[memory_limit] = {{.PHP.MemoryLimitMB}}M
php_admin_value[upload_max_filesize] = {{.PHP.UploadMaxMB}}M
php_admin_value[post_max_size] = {{.PostMaxMB}}M
php_admin_value[max_execution_time] = {{.PHP.MaxExecutionS}}
env[DB_HOST] = localhost
env[DB_SOCKET] = {{.DBSocket}}
env[DB_USER] = {{.ID}}
