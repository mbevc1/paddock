; Sockets created in /run/paddock/acme take the directory's type, which httpd_t may write to.
; The policy looks /run paths up as /var/run (file_contexts.subs_dist).
(filecon "/var/run/paddock/acme(/.*)?" any (system_u object_r httpd_var_run_t ((s0) (s0))))
; connectto is checked against the listening process, and paddock-web runs as
; unconfined_service_t until T3.4 gives it a domain of its own.
(allow httpd_t unconfined_service_t (unix_stream_socket (connectto)))
; Vhost units see a tmpfs over /srv/www, which systemd labels like /srv/www; it creates and
; mounts on each vhost's directory there.
(allow init_t httpd_sys_rw_content_t (dir (write add_name create mounton)))
; mod_md reaches Let's Encrypt on 443 and the front proxies each vhost's backend on 127.x:81,
; both HTTP ports; without this the host's booleans decide, and they may be off.
(allow httpd_t http_port_t (tcp_socket (name_connect)))
